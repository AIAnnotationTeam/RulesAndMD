# Next.js 通用环境变量模板
# 用途：新项目使用相同平台能力时，沿用相同变量名；未使用的平台不填写、不校验。
# 这是本仓库约定的命名契约，不代表各平台 SDK 会自动读取这些名称。
# 本地：复制到 Next.js 应用根目录并命名为 .env.local；env.example 本身不会自动加载。
# 线上：将对应变量配置到部署平台的环境变量 / Secrets，按服务白名单分发。
# 不沿用原项目 runtime.env、上传脚本或 wrangler vars 优先级等特殊约定。
#
# 命名规则：平台前缀 + 产品 / 能力 + 配置项；例如 CLOUDFLARE_R2_BUCKET_NAME。
# NEXT_PUBLIC_ 仅用于浏览器可见配置；其他变量默认仅限服务端，不等于自动保密。
# NEXT_PUBLIC_* 通常在 next build 时写入客户端产物，修改后需要重新构建发布。
# 密钥不得放入 NEXT_PUBLIC_* 或 next.config 的 env；真实配置文件不得提交版本控制。
# 环境读取与校验统一放在 src/lib/env/server.ts、client.ts，业务代码引用校验后的配置。
# 可选平台整组留空；启用时校验必需项，不用假值通过校验。空字符串不自动等于默认值。
# 布尔值、数字在环境中都是字符串，须显式解析；不能用 Boolean("false") 判断开关。
# *_TIMEOUT_MS / *_INTERVAL_MS / *_LEASE_MS 使用毫秒，*_TTL_SECONDS 使用秒。
# *_MODEL 存完整模型 ID；*_BASE_URL 存 API 基础地址；*_URL 存完整用途地址。
# 可使用官方 SDK 的标准变量名；新增平台按相同格式增加独立分组，不按页面或功能混放。
# 官方参考：
# https://nextjs.org/docs/app/guides/environment-variables
# https://supabase.com/docs/guides/getting-started/api-keys
# https://help.aliyun.com/zh/model-studio/base-url

# ============================================================================
# 1. Cloudflare
# ============================================================================

# 1.1 账号与管理 API（仅部署工具或调用 Cloudflare 管理 API 的服务需要）
# ACCOUNT_ID 是账号 ID；API_TOKEN 是限定权限的管理令牌，不是 Global API Key。
# 不要将部署管理令牌默认分发到 Web、翻译网关及所有后台服务。
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# 1.2 R2 对象存储（通过 S3 API 访问时填写）
# ENDPOINT 填控制台提供的 S3 API 地址，不填文件公开访问域名。
# 示例：https://your-account-id.r2.cloudflarestorage.com
# ACCESS_KEY_ID / SECRET_ACCESS_KEY 是 R2 S3 凭据，不是上面的管理 API_TOKEN。
# 权限限定到实际 Bucket；地域 / 管辖范围不同的 Endpoint 以控制台为准。
# 使用 Workers 原生 R2 binding 时，在 wrangler 配置绑定资源，不在 env 中放绑定对象。
# REGION 是 S3 SDK 配置值；R2 常规接入使用 auto。
# PUBLIC_BASE_URL 仅用于公开文件链接；私有文件使用短期签名，不配置公开访问绕过鉴权。
# https://developers.cloudflare.com/r2/api/tokens/
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# 1.3 Realtime SFU（需要实时音视频转发时填写）
# APP_ID / APP_SECRET 属于 Realtime SFU 应用，不是 Cloudflare 账号 ID 或管理令牌。
# App Secret 只在信令后端使用；音轨 ID、会话 ID 是运行时数据，不定义为全局配置。
# https://developers.cloudflare.com/realtime/sfu/
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_SECRET=

# 1.4 Realtime TURN（需要动态签发 TURN 客户端凭证时填写）
# KEY_ID / API_TOKEN 是 TURN Key 的 ID 和对应令牌，不是 SFU App Secret。
# 服务端用它们签发有过期时间的 ICE 凭证，不把长期令牌下发给浏览器。
# https://developers.cloudflare.com/realtime/turn/generate-credentials/
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# 1.5 Turnstile 人机验证（注意与 TURN 中继服务不同）
# SITE_KEY 是可公开的站点密钥；SECRET_KEY 只用于服务端校验验证结果。
# 未接入人机验证时整组留空，不使用任意占位值模拟验证通过。
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# 1.6 Workers 原生资源说明
# D1、KV、Queues、Durable Objects、Service Bindings、R2 binding 是运行时绑定。
# 在 wrangler.jsonc 中定义，并通过 Workers 运行时上下文读取；不伪装成字符串环境变量。
# 本模板不重复声明原生资源对象，也不把所有 Cloudflare 产品的配置预先塞进每个项目。

# ============================================================================
# 2. Supabase（身份认证与业务数据库）
# ============================================================================

# 2.1 浏览器和普通用户会话
# URL 是项目地址，例如 https://your-project.supabase.co。
# 新项目默认采用 publishable key（sb_publishable_...）；公开 key 配合用户会话与 RLS 使用。
# 服务端处理普通用户请求也应使用受用户权限约束的客户端，不默认使用管理密钥。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 2.2 服务端管理权限（仅确需管理操作的服务填写）
# SECRET_KEY 是 sb_secret_...，可绕过 RLS；与当前 Supabase 项目匹配，不能进入浏览器。
SUPABASE_SECRET_KEY=

# 2.3 旧项目兼容（只在旧 SDK / 既有代码确实使用时取消注释）
# legacy anon / service_role 与新版 key 类型不同，不把新版 key 填进旧名冒充同一种密钥。
# 新项目不同时维护两套同义配置；迁移时同步修改代码、SDK 与部署变量。
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# 3. 阿里云百炼（BAILIAN；模型品牌 Qwen / Wan 不作为凭据的平台前缀）
# ============================================================================

# 3.1 平台与鉴权
# 同一项目 / 服务的本组配置对应一个目标地域和业务空间。
# API_KEY 是百炼密钥，不是阿里云 AccessKey，也不是浏览器短期凭证。
# 北京示例 REGION=cn-beijing；该字段不会自动替换 URL，必须校验地域与地址一致。
# 需要跨地域或不同权限凭据时，为对应服务单独配置，不能把多个 Key 拼成一个值。
BAILIAN_REGION=cn-beijing
BAILIAN_API_KEY=

# 3.2 文本与兼容接口
# 填所选地域 / 业务空间的 OpenAI 兼容基础地址，不追加 /chat/completions。
# 示例：https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 不在通用模板固定 qwen-plus 等项目型号；采用时从百炼能力清单和官方目录选定。
BAILIAN_OPENAI_BASE_URL=
BAILIAN_TEXT_MODEL=
BAILIAN_TEXT_TIMEOUT_MS=300000

# 3.3 DashScope 原生 HTTP API
# 填完整原生 API 根路径，通常以 /api/v1 结尾，不是控制台网址或兼容 API 地址。
# 示例：https://your-workspace.cn-beijing.maas.aliyuncs.com/api/v1
# SDK 的 base_url 参数规则按实际 SDK 适配，不把同一个字符串强塞给所有客户端。
BAILIAN_DASHSCOPE_BASE_URL=

# 3.4 按能力选择模型；只填写项目实际使用的项，不默认加载全部能力。
BAILIAN_VISION_MODEL=
BAILIAN_OCR_MODEL=
BAILIAN_IMAGE_MODEL=
BAILIAN_VIDEO_MODEL=
BAILIAN_ASR_MODEL=
BAILIAN_FILE_ASR_MODEL=
BAILIAN_TTS_MODEL=
BAILIAN_EMBEDDING_MODEL=
BAILIAN_RERANK_MODEL=

# 3.5 实时对话与同传
# BASE_URL 为对应协议的完整 WebSocket 基础地址，不带密钥。
# 模型 ID 由请求构造器按接口要求传入；不要同时在 URL 和配置中维护两套不同型号。
# WebSocket、WebRTC 和非实时 HTTP 协议不能仅靠修改 BASE_URL 相互替代。
# 对话与同传分别配置，避免将回答模型当成翻译模型。
BAILIAN_REALTIME_BASE_URL=
BAILIAN_REALTIME_MODEL=
BAILIAN_LIVETRANSLATE_BASE_URL=
BAILIAN_LIVETRANSLATE_MODEL=

# 3.6 录音文件识别的客户端等待策略（使用文件 ASR 时读取）
# TIMEOUT 是应用等待任务的总上限，不代表容器持续占用或供应商承诺的 SLA。
# CHECK_INTERVAL 是状态查询间隔；是否释放进程、延期查询由项目调度实现。
BAILIAN_FILE_ASR_TIMEOUT_MS=7200000
BAILIAN_FILE_ASR_CHECK_INTERVAL_MS=15000

# ============================================================================
# 4. 支付宝 Alipay
# ============================================================================

# APP_ID 为开放平台应用 ID；SELLER_ID 为收款商户 PID，不是 APP_ID。
# PRIVATE_KEY 为应用私钥；PUBLIC_KEY 为支付宝公钥，不是应用公钥。
# 以下为公钥模式；采用证书模式的项目另外定义 ALIPAY_ 前缀的证书配置。
# GATEWAY_URL 留空，按测试 / 生产环境明确填写，不默认连接真实支付环境。
# NOTIFY_URL 填项目实际实现的公网 HTTPS 回调，不假设固定 API 路径或自动补默认值。
# PEM 多行值用双引号包裹；字面量 \n 是否需还原取决于加载器与 SDK，部署后验证。
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
ALIPAY_GATEWAY_URL=
ALIPAY_NOTIFY_URL=

# ============================================================================
# 5. Creem（海外普通 Web 支付）
# ============================================================================

# API_KEY 与 WEBHOOK_SECRET 仅用于服务端，须与所选测试 / 生产环境匹配。
# WEBHOOK_SECRET 用于校验原始请求体的 creem-signature，不使用前端成功跳转作为入账依据。
# TEST_MODE 是本仓库约定的开关，不是 SDK 自动读取的变量；显式解析后映射到适配器配置。
# 开发默认 true；正式收款前完成审核，切换生产配置并同步替换商品 ID、API Key 与 Webhook。
# 商品 ID 按项目套餐维护，不在通用模板预设固定商品；回调路径由项目实现并在 Creem 注册。
# Creem 托管收银台不沿用 Stripe 的浏览器 publishable key。
# 原平台凭据不能重命名复用，存量订单与订阅须单独迁移。
# https://docs.creem.io/getting-started/quickstart
# https://docs.creem.io/code/webhooks
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_TEST_MODE=true

# ============================================================================
# 6. 应用自身配置（不是第三方平台配置）
# ============================================================================

# 6.1 应用与部署
# APP_URL 是服务端生成绝对链接的规范站点地址，不是 Cloudflare / 百炼控制台地址。
# 不额外维护一个同义 NEXT_PUBLIC_APP_URL，浏览器默认从当前页面获取 origin。
# DEPLOYMENT_PLATFORM 由项目按所用部署适配器定义，不固定为 cloudflare。
# APP_MAINTENANCE_ENABLED 只提供开关值，具体限制哪些功能由项目实现。
# NODE_ENV 由 Next.js / 部署环境管理，不在这里自定义为 staging 等值。
APP_URL=http://localhost:3000
DEPLOYMENT_PLATFORM=
APP_MAINTENANCE_ENABLED=false

# 6.2 管理后台（仅使用应用内管理员白名单的项目）
# 用户 ID 格式由身份系统决定；Supabase Auth 用户使用 UUID，多个以英文逗号分隔。
# 留空时由应用拒绝白名单管理员访问，不得将空值解析为所有人均可访问。
ADMIN_USER_IDS=

# 6.3 支付业务（不属于支付宝或 Creem 平台凭据）
# 未使用支付时 PROVIDER 留空，不校验未启用平台；启用时由项目选择 alipay / creem。
# 默认付款窗口与查询频率是模板示例，项目采用后需在配置校验中明确范围。
# TRUST_PROXY 只有部署入口覆盖可信来源 IP 时启用，不因使用 Cloudflare 就自动开启。
PAYMENT_PROVIDER=
PAYMENT_ORDER_TIMEOUT_MINUTES=15
PAYMENT_STATUS_POLL_INTERVAL_MS=3000
PAYMENT_TRUST_PROXY=false

# 6.4 应用加密（仅实际加密保存 SDP Answer 的项目）
# 此组不是百炼或 Cloudflare 平台配置；未使用该业务时整组留空，不在启动时强制要求。
# KEY 解码后须为 32 字节；新环境可用 openssl rand -base64 32 生成。
# 已有密文需要匹配密钥和 KEY_ID；轮换需设计兼容解密，不能每次部署自动重建。
# REALTIME_SDP_ANSWER_KEY=
# REALTIME_SDP_ANSWER_KEY_ID=v1

# 6.5 录音业务示例（可选；不是所有项目都需要）
# 保留原项目配置供迁移参考，采用此业务时再取消注释并定义校验。
# 额度含义：每用户每日次数、每用户同时处理中任务数；与容器并发不是一回事。
# 上传、回放和 ASR 读取 URL 的签名 TTL 都属于应用存储访问策略，不属于模型凭据。
# RECORDING_ANALYSIS_ENABLED=false
# RECORDING_ANALYSIS_MAX_BYTES=100000000
# RECORDING_ANALYSIS_MAX_DURATION_SECONDS=3600
# RECORDING_ANALYSIS_DAILY_LIMIT=1
# RECORDING_ANALYSIS_MAX_ACTIVE=1
# RECORDING_UPLOAD_URL_TTL_SECONDS=600
# RECORDING_PLAYBACK_URL_TTL_SECONDS=300
# RECORDING_ASR_READ_URL_TTL_SECONDS=14400

# 6.6 后台任务示例（可选；APP_JOB_ 避免与 Cloudflare Workers 产品混淆）
# 租约与心跳必须结合任务幂等及续租逻辑实现，不是平台自动提供的能力。
# APP_JOB_POLL_INTERVAL_MS=5000
# APP_JOB_LEASE_MS=90000
# APP_JOB_HEARTBEAT_INTERVAL_MS=20000
# APP_JOB_TIMEOUT_MS=360000

# ============================================================================
# 7. 从原项目配置迁移（仅变量名映射，不是自动兼容别名）
# ============================================================================
# QWEN_REALTIME_API_KEY        -> BAILIAN_API_KEY
# QWEN_CHAT_BASE_URL           -> BAILIAN_OPENAI_BASE_URL
# QWEN_REPORT_MODEL            -> BAILIAN_TEXT_MODEL
# QWEN_CHAT_TIMEOUT_MS         -> BAILIAN_TEXT_TIMEOUT_MS
# R2_ENDPOINT                 -> CLOUDFLARE_R2_ENDPOINT
# R2_ACCESS_KEY_ID             -> CLOUDFLARE_R2_ACCESS_KEY_ID
# R2_SECRET_ACCESS_KEY         -> CLOUDFLARE_R2_SECRET_ACCESS_KEY
# R2_BUCKET                   -> CLOUDFLARE_R2_BUCKET_NAME
# DEPLOYMENT_MAINTENANCE_ENABLED -> APP_MAINTENANCE_ENABLED
# FILE_ASR_MODEL               -> BAILIAN_FILE_ASR_MODEL
# FILE_ASR_BASE_URL            -> BAILIAN_DASHSCOPE_BASE_URL（注意原值需补 /api/v1）
# FILE_ASR_API_KEY             -> BAILIAN_API_KEY（仅同地域、同权限时合并）
# FILE_ASR_TIMEOUT_MS          -> BAILIAN_FILE_ASR_TIMEOUT_MS
# FILE_ASR_CHECK_INTERVAL_MS   -> BAILIAN_FILE_ASR_CHECK_INTERVAL_MS
# FILE_ASR_READ_URL_TTL_SECONDS -> RECORDING_ASR_READ_URL_TTL_SECONDS
# WORKER_POLL_INTERVAL_MS      -> APP_JOB_POLL_INTERVAL_MS
# WORKER_LEASE_MS              -> APP_JOB_LEASE_MS
# WORKER_HEARTBEAT_INTERVAL_MS  -> APP_JOB_HEARTBEAT_INTERVAL_MS
# WORKER_JOB_TIMEOUT_MS        -> APP_JOB_TIMEOUT_MS
# FILE_ASR_PROVIDER 删除：百炼平台前缀已明确供应商；多供应商业务另设应用级选择器。
# Supabase 旧 key -> 新 key 是凭据类型与 SDK 迁移，不是简单重命名；兼容项见第 2 组。
# 迁移必须同步修改代码引用、校验器和部署白名单；仅替换 env 文件不能自动生效。
